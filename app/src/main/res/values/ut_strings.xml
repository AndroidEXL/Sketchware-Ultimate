    <string name="ut_exec_blocked_title">This device blocks executing files from app storage</string>
    <string name="ut_exec_blocked_msg">The files exist and carry the execute permission, but the operating system refuses to run them (SELinux / vendor restriction). The same restriction affects apps like Termux on such devices.\n\n%1$s</string>

