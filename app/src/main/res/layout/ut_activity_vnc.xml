<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.example.ubuntuterminal.VncView
        android:id="@+id/vnc_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/vnc_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textColor="#FFEEEEEE"
        android:textSize="16sp"
        android:padding="24dp"
        android:text="connecting..." />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:orientation="horizontal"
        android:padding="6dp">

        <Button android:id="@+id/vnc_btn_kbd"  android:layout_width="46dp" android:layout_height="40dp"
            android:text="&#8997;" android:textSize="17sp" android:textColor="#FFFFFFFF"
            android:background="#CC222222" android:layout_margin="3dp" />
        <Button android:id="@+id/vnc_btn_ctrl" android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="Ctrl" android:textSize="12sp" android:textColor="#FFFFFFFF"
            android:background="#CC222222" android:layout_margin="3dp" />
        <Button android:id="@+id/vnc_btn_alt"  android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="Alt" android:textSize="12sp" android:textColor="#FFFFFFFF"
            android:background="#CC222222" android:layout_margin="3dp" />
        <Button android:id="@+id/vnc_btn_fit"  android:layout_width="wrap_content" android:layout_height="40dp"
            android:text="Fit" android:textSize="12sp" android:textColor="#FFFFFFFF"
            android:background="#CC222222" android:layout_margin="3dp" />
        <Button android:id="@+id/vnc_btn_close" android:layout_width="46dp" android:layout_height="40dp"
            android:text="&#10005;" android:textSize="14sp" android:textColor="#FFFFFFFF"
            android:background="#CC552222" android:layout_margin="3dp" />
    </LinearLayout>

    <EditText
        android:id="@+id/vnc_kbd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0.85"
        android:hint="type - goes to the desktop"
        android:imeOptions="flagNoExtractUi"
        android:inputType="text"
        android:textColor="#FFFFFFFF"
        android:visibility="gone" />
</FrameLayout>
